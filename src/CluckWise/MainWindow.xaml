<Window UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" x:Class="CluckWise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CluckWise" Icon="pack://application:,,,/Assets/logo.png" Width="1100" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ground}"
        xmlns:local="clr-namespace:CluckWise">
  <Window.Resources>
    <local:SoundNameConverter x:Key="SoundName"/>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Ink}" Padding="14,22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,24">
          <Image Source="pack://application:,,,/Assets/logo.png" Width="42" Height="42"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="CluckWise" FontSize="20" FontWeight="ExtraBold" Foreground="White"/>
            <TextBlock Text="Rise wise." FontSize="12" Foreground="#BDB3A6"/>
          </StackPanel>
        </StackPanel>
        <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" GroupName="nav" Content="Settings" Checked="Nav_Checked"/>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource InkSoft}" CornerRadius="14" Padding="14,12" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="StreakCard_Click" ToolTip="Open Morning to-do">
          <StackPanel>
            <TextBlock Text="MORNING STREAK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Yolk}"/>
            <TextBlock x:Name="SideStreakText" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,3,0,2"/>
            <TextBlock x:Name="SideTodoText" FontSize="12" Foreground="#BDB3A6"/>
          </StackPanel>
        </Border>
        <StackPanel>
          <RadioButton x:Name="NavAlarms" Style="{StaticResource NavButton}" GroupName="nav" Content="Alarms" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavTimers" Style="{StaticResource NavButton}" GroupName="nav" Content="Timers" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavStopwatch" Style="{StaticResource NavButton}" GroupName="nav" Content="Stopwatch" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavMorning" Style="{StaticResource NavButton}" GroupName="nav" Content="Morning to-do" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavBirthdays" Style="{StaticResource NavButton}" GroupName="nav" Content="Birthdays" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>
  <DockPanel x:Name="AlarmsPage" Grid.Column="1" Margin="28,22">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+  New alarm" Click="NewAlarm_Click"/>
      <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="190" Margin="0,0,12,0" SelectionChanged="SortBox_SelectionChanged" ToolTip="How to order the alarms">
        <ComboBoxItem Content="Soonest first" Tag="Soonest"/>
        <ComboBoxItem Content="By group" Tag="Groups"/>
      </ComboBox>
      <StackPanel>
        <TextBlock Text="Alarms" FontSize="28" FontWeight="ExtraBold"/>
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Ink}" CornerRadius="20" Padding="26,20" Margin="0,0,0,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock x:Name="ClockText" FontSize="40" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Right"/>
          <TextBlock x:Name="DateText" FontSize="13" Foreground="{DynamicResource SideText}" HorizontalAlignment="Right"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="NEXT ALARM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Yolk}"/>
          <TextBlock x:Name="NextText" FontSize="24" FontWeight="ExtraBold" Foreground="White" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="NextWhen" FontSize="14" Foreground="{DynamicResource SideText}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ItemsControl x:Name="WorldClockList" DockPanel.Dock="Top" Margin="0,0,0,14">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="16,10" Margin="0,0,10,8" MinWidth="150"
                  Cursor="SizeAll" ToolTip="Drag to rearrange" AllowDrop="True"
                  PreviewMouseLeftButtonDown="Clock_MouseDown" PreviewMouseMove="Clock_MouseMove"
                  DragOver="Clock_DragOver" DragLeave="Clock_DragLeave" Drop="Clock_Drop">
            <StackPanel>
              <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
              <TextBlock Text="{Binding TimeText}" FontSize="22" FontWeight="ExtraBold"/>
              <TextBlock Text="{Binding DayText}" FontSize="12" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ListBox x:Name="AlarmList" BorderThickness="0" Background="Transparent"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
      <ListBox.Resources>
        <Style x:Key="DayDot" TargetType="Border">
          <Setter Property="Width" Value="30"/>
          <Setter Property="Height" Value="26"/>
          <Setter Property="CornerRadius" Value="8"/>
          <Setter Property="Margin" Value="0,0,4,0"/>
          <Setter Property="Background" Value="{DynamicResource Chip}"/>
        </Style>
        <Style x:Key="DayDotText" TargetType="TextBlock">
          <Setter Property="FontSize" Value="11"/>
          <Setter Property="FontWeight" Value="Bold"/>
          <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
          <Setter Property="HorizontalAlignment" Value="Center"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
      </ListBox.Resources>
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="-4,8,0,4"
                      HorizontalAlignment="Left" Cursor="SizeAll" ToolTip="Drag to reorder · right-click to delete" AllowDrop="True"
                      PreviewMouseLeftButtonDown="Group_MouseDown" PreviewMouseMove="Group_MouseMove"
                      DragOver="Group_DragOver" DragLeave="Group_DragLeave" Drop="Group_Drop">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Delete group…" Click="DeleteGroup_Click"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="10" Height="10" Fill="{DynamicResource Yolk}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="8,0,0,0"/>
                  <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" FontSize="13" Foreground="{DynamicResource Muted}"/>
                  <TextBlock Text="  ⠿" FontSize="13" Foreground="{DynamicResource Muted}" Opacity="0.6"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource Text}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="0,0,0,10" >
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#D9CFC0"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Yolk}"/><Setter TargetName="card" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
          <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="CardHeader_Click" ToolTip="Click to edit">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="30" FontWeight="ExtraBold">
              <Run Text="{Binding TimeText, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding AmPm, Mode=OneWay}" FontSize="15" Foreground="{DynamicResource Muted}"/>
            </TextBlock>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
              <StackPanel x:Name="chips" Orientation="Horizontal" Visibility="Collapsed">
                <Border x:Name="d0" Style="{StaticResource DayDot}"><TextBlock x:Name="t0" Text="Su" Style="{StaticResource DayDotText}"/></Border>
                <Border x:Name="d1" Style="{StaticResource DayDot}"><TextBlock x:Name="t1" Text="Mo" Style="{StaticResource DayDotText}"/></Border>
                <Border x:Name="d2" Style="{StaticResource DayDot}"><TextBlock x:Name="t2" Text="Tu" Style="{StaticResource DayDotText}"/></Border>
                <Border x:Name="d3" Style="{StaticResource DayDot}"><TextBlock x:Name="t3" Text="We" Style="{StaticResource DayDotText}"/></Border>
                <Border x:Name="d4" Style="{StaticResource DayDot}"><TextBlock x:Name="t4" Text="Th" Style="{StaticResource DayDotText}"/></Border>
                <Border x:Name="d5" Style="{StaticResource DayDot}"><TextBlock x:Name="t5" Text="Fr" Style="{StaticResource DayDotText}"/></Border>
                <Border x:Name="d6" Style="{StaticResource DayDot}"><TextBlock x:Name="t6" Text="Sa" Style="{StaticResource DayDotText}"/></Border>
              </StackPanel>
              <TextBlock x:Name="repeatText" Text="{Binding RepeatText, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
            <TextBlock x:Name="countdownText" Grid.Column="2" Width="160" Text="{Binding Countdown, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="soundText" Grid.Column="3" Width="140" Text="{Binding Sound, Converter={StaticResource SoundName}}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Switch_Click"/>
          </Grid>
          <ContentControl x:Name="editorHost" Content="{Binding}"/>
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
              <Setter TargetName="editorHost" Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate><local:AlarmEditorPanel/></DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
              <Setter TargetName="editorHost" Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate/>
                </Setter.Value>
              </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="compact">
              <Setter TargetName="soundText" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="countdownText" Property="Width" Value="120"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Repeat}" Value="Weekly">
              <Setter TargetName="chips" Property="Visibility" Value="Visible"/>
              <Setter TargetName="repeatText" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Days[0]}" Value="True"><Setter TargetName="d0" Property="Background" Value="{DynamicResource Ink}"/><Setter TargetName="t0" Property="Foreground" Value="White"/></DataTrigger>
            <DataTrigger Binding="{Binding Days[1]}" Value="True"><Setter TargetName="d1" Property="Background" Value="{DynamicResource Ink}"/><Setter TargetName="t1" Property="Foreground" Value="White"/></DataTrigger>
            <DataTrigger Binding="{Binding Days[2]}" Value="True"><Setter TargetName="d2" Property="Background" Value="{DynamicResource Ink}"/><Setter TargetName="t2" Property="Foreground" Value="White"/></DataTrigger>
            <DataTrigger Binding="{Binding Days[3]}" Value="True"><Setter TargetName="d3" Property="Background" Value="{DynamicResource Ink}"/><Setter TargetName="t3" Property="Foreground" Value="White"/></DataTrigger>
            <DataTrigger Binding="{Binding Days[4]}" Value="True"><Setter TargetName="d4" Property="Background" Value="{DynamicResource Ink}"/><Setter TargetName="t4" Property="Foreground" Value="White"/></DataTrigger>
            <DataTrigger Binding="{Binding Days[5]}" Value="True"><Setter TargetName="d5" Property="Background" Value="{DynamicResource Ink}"/><Setter TargetName="t5" Property="Foreground" Value="White"/></DataTrigger>
            <DataTrigger Binding="{Binding Days[6]}" Value="True"><Setter TargetName="d6" Property="Background" Value="{DynamicResource Ink}"/><Setter TargetName="t6" Property="Foreground" Value="White"/></DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
  <local:TimersPage x:Name="TimersView" Grid.Column="1" Margin="28,22" Visibility="Collapsed"/>
  <local:StopwatchPage x:Name="StopwatchView" Grid.Column="1" Margin="28,22" Visibility="Collapsed"/>
  <local:SettingsPage x:Name="SettingsView" Grid.Column="1" Margin="28,22" Visibility="Collapsed"/>
  <local:MorningPage x:Name="MorningView" Grid.Column="1" Margin="28,22" Visibility="Collapsed"/>
  <local:BirthdaysPage x:Name="BirthdaysView" Grid.Column="1" Margin="28,22" Visibility="Collapsed"/>
  <Border x:Name="UndoBar" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
          Background="{DynamicResource Ink}" CornerRadius="14" Padding="20,10,10,10" Visibility="Collapsed" Opacity="0">
    <Border.RenderTransform><TranslateTransform x:Name="UndoSlide" Y="20"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25"/></Border.Effect>
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="UndoText" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,18,0"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Undo" Height="36" Padding="16,0" Click="Undo_Click"/>
    </StackPanel>
  </Border>
  </Grid>
</Window>
