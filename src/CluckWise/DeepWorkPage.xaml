<UserControl x:Class="CluckWise.DeepWorkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- Set up a session -->
    <ScrollViewer x:Name="SetupView" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Deep Work" FontSize="28" FontWeight="ExtraBold"/>
        <TextBlock Text="Focus in sessions with short breaks. Reminders wait until your break; alarms still ring." FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,0,18" TextWrapping="Wrap"/>

        <UniformGrid Columns="3" Margin="0,0,0,18">
          <Border Background="{DynamicResource Ink}" CornerRadius="18" Padding="20,16" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="TODAY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Yolk}"/>
              <TextBlock x:Name="TodayText" FontSize="26" FontWeight="ExtraBold" Foreground="White"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="20,16" Margin="4,0">
            <StackPanel>
              <TextBlock Text="THIS WEEK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="WeekText" FontSize="26" FontWeight="ExtraBold"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="20,16" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="FOCUS STREAK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="StreakText" FontSize="26" FontWeight="ExtraBold"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="22,18">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionLabel}" Text="WHAT ARE YOU WORKING ON?"/>
            <Grid Margin="0,0,0,16">
              <TextBox x:Name="TaskBox" Style="{StaticResource Field}" TextChanged="TaskBox_TextChanged" KeyDown="TaskBox_KeyDown"/>
              <TextBlock x:Name="TaskHint" Text="e.g. Write the proposal" Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <TextBlock Style="{StaticResource SectionLabel}" Text="SESSION LENGTH"/>
            <WrapPanel Margin="0,0,0,12">
              <RadioButton x:Name="Len25" Content="25 min" GroupName="len" Margin="0,0,18,8" Checked="Len_Checked"/>
              <RadioButton x:Name="Len50" Content="50 min" GroupName="len" Margin="0,0,18,8" Checked="Len_Checked"/>
              <RadioButton x:Name="Len90" Content="90 min" GroupName="len" Margin="0,0,18,8" Checked="Len_Checked"/>
              <RadioButton x:Name="LenCustom" Content="Custom" GroupName="len" Margin="0,0,8,8" Checked="Len_Checked"/>
              <TextBox x:Name="CustomBox" Style="{StaticResource Field}" Width="70" Height="36" Margin="0,-4,6,8" TextChanged="Custom_Changed"/>
              <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource Muted}"/>
            </WrapPanel>

            <WrapPanel Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Margin="0,0,24,10">
                <TextBlock Text="Break" VerticalAlignment="Center" Width="60"/>
                <ComboBox x:Name="BreakBox" Width="120" SelectionChanged="Settings_Changed"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Background sound" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="SoundBox" Width="160" SelectionChanged="Settings_Changed"/>
              </StackPanel>
            </WrapPanel>
            <CheckBox x:Name="RepeatBox" Content="Start the next session after each break (long break every 4th)" Margin="0,0,0,8" Click="Settings_Changed"/>
            <CheckBox x:Name="QuietBox" Content="Hold reminders and pop-ups until the break" Margin="0,0,0,18" Click="Settings_Changed"/>

            <Button Style="{StaticResource PrimaryButton}" Content="Start focusing" Height="52" FontSize="16" HorizontalAlignment="Left" Padding="28,0" Click="Start_Click"/>
            <TextBlock Text="Tip: Ctrl+Alt+F starts or stops a session from anywhere." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- A session in progress -->
    <Border x:Name="RunningView" Visibility="Collapsed" Background="{DynamicResource Ink}" CornerRadius="24">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="PhaseText" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Yolk}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="RunTaskText" FontSize="22" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,22" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
        <Grid Width="280" Height="280">
          <Ellipse Stroke="#3A332B" StrokeThickness="16"/>
          <Path x:Name="Arc" Stroke="{DynamicResource Yolk}" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="RemainText" FontSize="58" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SessionText" FontSize="13" Foreground="{DynamicResource SideText}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
          <Button x:Name="PauseButton" Style="{StaticResource PrimaryButton}" Width="140" Height="48" FontSize="15" Margin="0,0,10,0" Click="Pause_Click"/>
          <Button x:Name="SkipButton" Style="{StaticResource SecondaryButton}" Content="Skip break" Width="140" Height="48" FontSize="15" Margin="0,0,10,0" Click="Skip_Click"/>
          <Button Style="{StaticResource SecondaryButton}" Content="End" Width="120" Height="48" FontSize="15" Click="End_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
