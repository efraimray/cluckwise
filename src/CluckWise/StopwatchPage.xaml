<UserControl x:Class="CluckWise.StopwatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Stopwatch" FontSize="28" FontWeight="ExtraBold"/>
      <TextBlock Text="Keeps running while CluckWise is in the tray" FontSize="14" Foreground="{DynamicResource Muted}"/>
    </StackPanel>

    <Border DockPanel.Dock="Top" Background="{DynamicResource Ink}" CornerRadius="24" Padding="30,28" Margin="0,0,0,18">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock x:Name="TimeText" Text="00:00.00" FontSize="76" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
        <TextBlock x:Name="LapNowText" Text=" " FontSize="15" Foreground="{DynamicResource SideText}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Start" Width="130" Height="48" FontSize="16" Margin="0,0,10,0" Click="Start_Click"/>
          <Button x:Name="LapButton" Style="{StaticResource SecondaryButton}" Content="Lap" Width="130" Height="48" FontSize="16" Margin="0,0,10,0" Click="Lap_Click" IsEnabled="False"/>
          <Button Style="{StaticResource SecondaryButton}" Content="Reset" Width="130" Height="48" FontSize="16" Click="Reset_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Text="LAPS"/>
    <TextBlock x:Name="NoLapsText" DockPanel.Dock="Top" Text="Press Lap while it's running to record a split." Foreground="{DynamicResource Muted}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="LapList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,10" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Split}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="14" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
