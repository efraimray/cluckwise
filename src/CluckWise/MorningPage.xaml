<UserControl x:Class="CluckWise.MorningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Morning to-do" FontSize="28" FontWeight="ExtraBold"/>
      <TextBlock Text="Shows up when you dismiss a morning alarm, and resets every day" FontSize="14" Foreground="{StaticResource Muted}"/>
    </StackPanel>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource Ink}" CornerRadius="20" Padding="24,20">
        <StackPanel>
          <TextBlock Text="STREAK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Yolk}"/>
          <TextBlock x:Name="StreakText" FontSize="26" FontWeight="ExtraBold" Foreground="White" Margin="0,4,0,2" TextWrapping="Wrap"/>
          <TextBlock x:Name="BestText" FontSize="13" Foreground="{StaticResource SideText}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="24,20">
        <StackPanel>
          <TextBlock Text="TODAY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="ProgressText" FontSize="26" FontWeight="ExtraBold" Margin="0,4,0,8"/>
          <ProgressBar x:Name="ProgressBar" Height="8" Maximum="1" Foreground="{StaticResource Yolk}" Background="#F3EFE8" BorderThickness="0"/>
        </StackPanel>
      </Border>
    </Grid>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Add" Margin="10,0,0,0" Click="Add_Click"/>
      <TextBox x:Name="NewTaskBox" Style="{StaticResource Field}" KeyDown="NewTaskBox_KeyDown" ToolTip="Type a task and press Enter"/>
    </DockPanel>

    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="Your list is empty. Add something small you want to do every morning." Foreground="{StaticResource Muted}"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="TaskList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16,10" Margin="0,0,0,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource Muted}" Cursor="Hand" ToolTip="Remove" Tag="{Binding}" Click="Remove_Click"/>
                <CheckBox Content="{Binding Text}" IsChecked="{Binding Done}" FontSize="15" VerticalAlignment="Center" Click="Task_Click"/>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
