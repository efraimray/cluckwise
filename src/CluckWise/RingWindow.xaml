<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="CluckWise.RingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CluckWise alarm" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource Ink}">
  <Grid>
  <StackPanel x:Name="RingPanel" Margin="32,28">
    <Image Source="pack://application:,,,/Assets/logo.png" Width="72" Height="72" Margin="0,0,0,10"/>
    <TextBlock x:Name="HeaderText" Text="TIME TO RISE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Yolk}" HorizontalAlignment="Center"/>
    <TextBlock x:Name="TimeText" FontSize="64" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0"/>
    <TextBlock x:Name="LabelText" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
    <TextBlock x:Name="ActionsText" FontSize="13" Foreground="{DynamicResource SideText}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
    <Button x:Name="DismissButton" Style="{StaticResource PrimaryButton}" Content="Dismiss" Height="52" FontSize="16" Margin="0,24,0,10" Click="Dismiss_Click"/>
    <Button x:Name="SnoozeButton" Style="{StaticResource SecondaryButton}" Height="48" Click="Snooze_Click"/>
    <TextBlock Text="Space to dismiss · S to snooze" FontSize="12" Foreground="#9C9286" HorizontalAlignment="Center" Margin="0,12,0,0"/>
  </StackPanel>
  <StackPanel x:Name="ChallengePanel" Margin="32,28" Visibility="Collapsed">
    <TextBlock Text="WAKE-UP CHALLENGE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Yolk}" HorizontalAlignment="Center"/>
    <TextBlock x:Name="ChallengeTitle" FontSize="20" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,4"/>
    <TextBlock x:Name="ChallengeHint" FontSize="13" Foreground="{DynamicResource SideText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <TextBlock x:Name="ChallengeQuestion" FontSize="40" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <TextBox x:Name="ChallengeInput" Style="{StaticResource Field}" Height="50" FontSize="18" Margin="0,0,0,10"/>
    <UniformGrid x:Name="TileGrid" Margin="0,0,0,10"/>
    <TextBlock x:Name="ChallengeError" Foreground="#FF8A80" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>
    <Button x:Name="ChallengeCheck" Style="{StaticResource PrimaryButton}" Content="Check" Height="50" FontSize="16" Margin="0,4,0,10" Click="ChallengeCheck_Click"/>
    <Button x:Name="ChallengeSnooze" Style="{StaticResource SecondaryButton}" Height="44" Click="Snooze_Click"/>
  </StackPanel>
  <StackPanel x:Name="TodoPanel" Margin="32,28" Visibility="Collapsed" TextElement.Foreground="White">
    <Image Source="pack://application:,,,/Assets/logo.png" Width="64" Height="64" Margin="0,0,0,8"/>
    <TextBlock Text="GOOD MORNING" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Yolk}" HorizontalAlignment="Center"/>
    <TextBlock x:Name="StreakText" FontSize="24" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,2" TextAlignment="Center" TextWrapping="Wrap"/>
    <TextBlock x:Name="StreakHint" FontSize="13" Foreground="{DynamicResource SideText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <Border x:Name="BriefingBox" Background="{DynamicResource InkSoft}" CornerRadius="16" Padding="18,12" Margin="0,0,0,12" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="Today" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
        <ItemsControl x:Name="BriefingList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource SideText}" TextWrapping="Wrap" Margin="0,2"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Background="{DynamicResource InkSoft}" CornerRadius="16" Padding="18,12">
      <StackPanel>
        <TextBlock Text="Your morning plan" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
        <ItemsControl x:Name="TaskList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Text}" IsChecked="{Binding Done}" Foreground="White" Margin="0,6" Click="Task_Click"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Button Style="{StaticResource PrimaryButton}" Content="Let's go" Height="52" FontSize="16" Margin="0,20,0,0" Click="LetsGo_Click"/>
  </StackPanel>
  </Grid>
</Window>
