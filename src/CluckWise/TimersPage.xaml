<UserControl x:Class="CluckWise.TimersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Timers" FontSize="28" FontWeight="ExtraBold"/>
      <TextBlock Text="Run several countdowns at once" FontSize="14" Foreground="{DynamicResource Muted}"/>
    </StackPanel>

    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionLabel}" Text="QUICK START"/>
        <WrapPanel Margin="0,0,0,12">
          <Button Style="{StaticResource SecondaryButton}" Content="1 min" Tag="60" Margin="0,0,8,8" Click="Preset_Click"/>
          <Button Style="{StaticResource SecondaryButton}" Content="5 min" Tag="300" Margin="0,0,8,8" Click="Preset_Click"/>
          <Button Style="{StaticResource SecondaryButton}" Content="10 min" Tag="600" Margin="0,0,8,8" Click="Preset_Click"/>
          <Button Style="{StaticResource SecondaryButton}" Content="25 min focus" Tag="1500" Margin="0,0,8,8" Click="Preset_Click"/>
          <Button Style="{StaticResource SecondaryButton}" Content="1 hour" Tag="3600" Margin="0,0,8,8" Click="Preset_Click"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource SectionLabel}" Text="CUSTOM TIMER"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Start timer" Margin="10,0,0,0" Click="StartCustom_Click"/>
          <TextBox x:Name="SecondsBox" DockPanel.Dock="Right" Style="{StaticResource Field}" Width="70" Text="0" Margin="8,0,0,0" ToolTip="Seconds"/>
          <TextBlock DockPanel.Dock="Right" Text="sec" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Muted}"/>
          <TextBox x:Name="MinutesBox" DockPanel.Dock="Right" Style="{StaticResource Field}" Width="70" Text="15" Margin="10,0,0,0" ToolTip="Minutes"/>
          <TextBlock DockPanel.Dock="Right" Text="min" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Muted}"/>
          <TextBox x:Name="LabelBox" Style="{StaticResource Field}" Text="Timer" ToolTip="Name, e.g. Tea or Laundry"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="No timers yet — pick a quick start above." Foreground="{DynamicResource Muted}" Margin="2,0,0,0"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="TimerList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="260" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="20,18" Margin="0,0,14,14">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Muted}" Cursor="Hand" ToolTip="Delete timer" Tag="{Binding}" Click="Delete_Click"/>
                  <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Text="{Binding RemainingText}" FontSize="44" FontWeight="ExtraBold" Margin="0,6,0,4"/>
                <TextBlock Text="{Binding DurationText, StringFormat='of {0}'}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="8" Foreground="{DynamicResource Yolk}" Background="{DynamicResource Chip}" BorderThickness="0" Margin="0,0,0,14"/>
                <UniformGrid Columns="2">
                  <Button Style="{StaticResource PrimaryButton}" Content="{Binding StartPauseText}" Height="40" Margin="0,0,5,0" Tag="{Binding}" Click="StartPause_Click"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Reset" Height="40" Margin="5,0,0,0" Tag="{Binding}" Click="Reset_Click"/>
                </UniformGrid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
