<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CluckWise</AssemblyName>
    <RootNamespace>CluckWise</RootNamespace>
    <Product>CluckWise</Product>
    <Description>CluckWise — alarms that help you rise wise.</Description>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\cluckwise.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid clashes between WPF and WinForms names; WinForms is only used for the tray icon. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows' built-in text-to-speech, for the talking alarm and morning briefing -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

</Project>
