<Window x:Class="CluckWise.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CluckWise widget" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" ShowActivated="False">
  <Border x:Name="Card" Background="{DynamicResource Ink}" CornerRadius="18" Padding="16,12,14,12" Margin="10"
          MinWidth="230" Cursor="SizeAll" MouseLeftButtonDown="Card_MouseLeftButtonDown"
          MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" ToolTip="Drag to move · double-click to open CluckWise">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35"/>
    </Border.Effect>
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Open CluckWise" Click="Open_Click"/>
        <MenuItem Header="Move back to the corner" Click="ResetPosition_Click"/>
        <Separator/>
        <MenuItem Header="Hide widget" Click="Hide_Click"/>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image Source="pack://application:,,,/Assets/logo.png" Width="26" Height="26" VerticalAlignment="Center"/>
          <TextBlock x:Name="ClockText" FontSize="26" FontWeight="ExtraBold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="NEXT ALARM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Yolk}" Margin="0,8,0,1"/>
        <TextBlock x:Name="NextText" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
        <TextBlock x:Name="NextWhen" FontSize="12" Foreground="{DynamicResource SideText}"/>
        <StackPanel x:Name="TimerPanel" Visibility="Collapsed" Margin="0,8,0,0">
          <TextBlock Text="TIMER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Yolk}" Margin="0,0,0,1"/>
          <TextBlock x:Name="TimerText" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
        </StackPanel>
      </StackPanel>
      <Button x:Name="CloseButton" Content="✕" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,-4,-6,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SideText}"
              Cursor="Hand" ToolTip="Hide widget" Opacity="0" Click="Hide_Click"/>
    </Grid>
  </Border>
</Window>
