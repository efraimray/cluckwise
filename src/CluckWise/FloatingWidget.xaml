<Window x:Class="CluckWise.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CluckWise widget" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" ShowActivated="False">

  <Border x:Name="Card" Background="{DynamicResource Ink}" CornerRadius="14" Padding="12,8,12,9" Margin="8"
          MaxWidth="250" Cursor="SizeAll" MouseLeftButtonDown="Card_MouseLeftButtonDown"
          MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" ToolTip="Drag to move · double-click to open CluckWise">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
    </Border.Effect>
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Open CluckWise" Click="Open_Click"/>
        <MenuItem Header="Move back to the corner" Click="ResetPosition_Click"/>
        <Separator/>
        <MenuItem Header="Hide widget" Click="Hide_Click"/>
      </ContextMenu>
    </Border.ContextMenu>
    <StackPanel>
      <DockPanel>
        <Image Source="pack://application:,,,/Assets/logo.png" Width="18" Height="18" VerticalAlignment="Center"/>
        <TextBlock x:Name="ClockText" FontSize="18" FontWeight="ExtraBold" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Margin="0,5,0,0" FontSize="12" TextTrimming="CharacterEllipsis">
        <Run Text="Next " Foreground="{DynamicResource Yolk}" FontWeight="Bold"/><Run x:Name="NextRun" Foreground="White" FontWeight="SemiBold"/>
      </TextBlock>
      <TextBlock x:Name="NextWhen" FontSize="11" Foreground="{DynamicResource SideText}" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="FocusLine" Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed">
        <Run x:Name="FocusLabel" Text="Focus " Foreground="{DynamicResource Yolk}" FontWeight="Bold"/><Run x:Name="FocusRun" Foreground="White" FontWeight="SemiBold"/>
      </TextBlock>
      <TextBlock x:Name="TimerLine" Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed">
        <Run Text="Timer " Foreground="{DynamicResource Yolk}" FontWeight="Bold"/><Run x:Name="TimerRun" Foreground="White" FontWeight="SemiBold"/>
      </TextBlock>
    </StackPanel>
  </Border>
</Window>
