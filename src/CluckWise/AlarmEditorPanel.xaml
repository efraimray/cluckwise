<UserControl x:Class="CluckWise.AlarmEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14" Loaded="Panel_Loaded" SizeChanged="Panel_SizeChanged" Opacity="0">
  <UserControl.RenderTransform>
    <TranslateTransform x:Name="drop" Y="-12"/>
  </UserControl.RenderTransform>
  <UserControl.Triggers>
    <EventTrigger RoutedEvent="UserControl.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
          <DoubleAnimation Storyboard.TargetName="drop" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </UserControl.Triggers>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,16,0,0">
      <DockPanel>
        <Button x:Name="DeleteButton" Style="{StaticResource SecondaryButton}" Content="Delete" Click="Delete_Click"/>
        <Button Style="{StaticResource SecondaryButton}" Content="Ring now" Margin="10,0,0,0" Click="RingNow_Click" ToolTip="Hear and see this alarm right away (actions are not run)"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,10,0" Click="Cancel_Click"/>
          <Button Style="{StaticResource PrimaryButton}" Content="Save alarm" Click="Save_Click"/>
        </StackPanel>
        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <Grid x:Name="EditorGrid" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <Border Background="{DynamicResource Ink}" CornerRadius="20" Padding="12" Margin="0,0,0,20">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox x:Name="HourBox" Style="{StaticResource TimeCombo}" Width="96" SelectionChanged="Changed"/>
            <TextBlock Text=":" FontSize="40" FontWeight="ExtraBold" Foreground="{DynamicResource Yolk}" Margin="6,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="MinuteBox" Style="{StaticResource TimeCombo}" Width="96" SelectionChanged="Changed"/>
            <ComboBox x:Name="AmPmBox" Style="{StaticResource TimeCombo}" Width="92" FontSize="22" Margin="10,0,0,0" SelectionChanged="Changed">
              <ComboBoxItem Content="AM"/>
              <ComboBoxItem Content="PM"/>
            </ComboBox>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionLabel}" Text="REPEAT"/>
        <WrapPanel Margin="0,0,0,6">
          <RadioButton x:Name="OnceRadio" Content="Once" GroupName="repeat" Margin="0,0,18,6" Checked="Changed"/>
          <RadioButton x:Name="DailyRadio" Content="Every day" GroupName="repeat" Margin="0,0,18,6" Checked="Changed"/>
          <RadioButton x:Name="WeeklyRadio" Content="Chosen days" GroupName="repeat" Margin="0,0,18,6" Checked="Changed"/>
          <RadioButton x:Name="MonthlyRadio" Content="Monthly" GroupName="repeat" Margin="0,0,18,6" Checked="Changed"/>
          <RadioButton x:Name="YearlyRadio" Content="Yearly" GroupName="repeat" Margin="0,0,0,6" Checked="Changed"/>
        </WrapPanel>
        <StackPanel x:Name="DaysPanel" Orientation="Horizontal" Margin="0,0,0,10"/>
        <StackPanel x:Name="DateRow" Orientation="Horizontal" Margin="0,0,0,10">
          <DatePicker x:Name="OnceDatePicker" Width="200" SelectedDateChanged="Changed"/>
          <TextBlock x:Name="DateHint" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <TextBlock Style="{StaticResource SectionLabel}" Text="LABEL" Margin="0,10,0,8"/>
        <TextBox x:Name="LabelBox" Style="{StaticResource Field}" TextChanged="Changed" Margin="0,0,0,12"/>
        <TextBlock Style="{StaticResource SectionLabel}" Text="GROUP"/>
        <ComboBox x:Name="GroupBox" IsEditable="True"/>
      </StackPanel>

      <StackPanel x:Name="RightColumn" Grid.Column="2">
        <TextBlock Style="{StaticResource SectionLabel}" Text="SOUND"/>
        <DockPanel Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Your own…" Margin="8,0,0,0" Click="BrowseSound_Click"/>
          <Button x:Name="PreviewButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Play" Margin="8,0,0,0" Click="Preview_Click"/>
          <ComboBox x:Name="SoundBox"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right"/>
          <TextBlock Text="Volume" Width="70"/>
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" ValueChanged="Volume_Changed"/>
        </DockPanel>
        <CheckBox x:Name="GentleBox" Content="Gentle wake-up (volume rises over 30 seconds)" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,2">
          <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
            <TextBlock Text="Snooze for" VerticalAlignment="Center" Width="90"/>
            <ComboBox x:Name="SnoozeBox" Width="130"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Remind me" VerticalAlignment="Center" Width="90"/>
            <ComboBox x:Name="ReminderBox" Width="150"/>
          </StackPanel>
        </WrapPanel>
        <CheckBox x:Name="WakeBox" Content="Wake the PC from sleep for this alarm" Margin="0,0,0,18"/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="WHEN IT RINGS…"/>
        <Grid Margin="0,0,0,8">
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" CornerRadius="12" Padding="4">
            <ListBox x:Name="ActionsList" Height="110" BorderThickness="0" Background="Transparent" PreviewMouseWheel="PassWheelToPage" HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="6,4"
                          Cursor="SizeAll" ToolTip="Drag to change the order" AllowDrop="True"
                          PreviewMouseLeftButtonDown="Action_MouseDown" PreviewMouseMove="Action_MouseMove"
                          DragOver="Action_DragOver" DragLeave="Action_DragLeave" Drop="Action_Drop">
                    <DockPanel>
                      <TextBlock Text="⠿" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <TextBlock x:Name="NoActionsText" Text="Nothing extra — it just rings.&#x0a;Add a website or app to open automatically." TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <WrapPanel Margin="0,0,0,8">
          <Button Style="{StaticResource SecondaryButton}" Content="+ Website" Height="36" Margin="0,0,8,8" Click="AddWebsite_Click"/>
          <Button Style="{StaticResource SecondaryButton}" Content="+ App or file" Height="36" Margin="0,0,8,8" Click="AddProgram_Click"/>
          <Button Style="{StaticResource SecondaryButton}" Content="+ Music" Height="36" Margin="0,0,8,8" Click="AddMusic_Click" ToolTip="Play a song or playlist file"/>
          <Button x:Name="PcActionButton" Style="{StaticResource SecondaryButton}" Content="+ PC action ▾" Height="36" Margin="0,0,8,8" Click="PcAction_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Lock the PC" Tag="LockPC" Click="PcActionItem_Click"/>
                <MenuItem Header="Turn off the screen" Tag="ScreenOff" Click="PcActionItem_Click"/>
                <MenuItem Header="Put the PC to sleep" Tag="Sleep" Click="PcActionItem_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Content="Test" Height="36" Margin="0,0,8,8" Click="TestAction_Click"/>
          <Button Style="{StaticResource SecondaryButton}" Content="Remove" Height="36" Margin="0,0,8,8" Click="RemoveAction_Click"/>
        </WrapPanel>
        <CheckBox x:Name="SilentBox" Content="Run silently (do the actions, no ringing)" Margin="0,0,0,8"/>
        <CheckBox x:Name="EnabledBox" Content="Alarm is on"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
