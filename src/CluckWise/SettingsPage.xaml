<UserControl x:Class="CluckWise.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Settings" FontSize="28" FontWeight="ExtraBold"/>
      <TextBlock Text="Changes are saved straight away" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>

      <TextBlock Style="{StaticResource SectionLabel}" Text="GENERAL"/>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20,6" Margin="0,0,0,22">
        <StackPanel>
          <DockPanel Margin="0,10">
            <CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Startup_Click"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Start with Windows" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="Opens quietly in the tray when you sign in, so alarms ring after a restart" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Border Height="1" Background="{StaticResource Line}"/>
          <DockPanel Margin="0,10">
            <CheckBox x:Name="TodoSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Todo_Click"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Show morning to-do after morning alarms" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="When you dismiss an alarm set before noon, show your checklist and streak" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Border Height="1" Background="{StaticResource Line}"/>
          <DockPanel Margin="0,10">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Closing the window" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="CluckWise keeps running in the tray. Right-click the tray icon and choose Quit to close it fully." FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionLabel}" Text="WAKE FROM SLEEP"/>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20,16" Margin="0,0,0,22">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Power settings" VerticalAlignment="Center" Margin="12,0,0,0" Click="Power_Click"/>
          <StackPanel>
            <TextBlock x:Name="WakeStatusText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Windows must allow wake timers: Power settings → Change plan settings → Change advanced power settings → Sleep → Allow wake timers → Enable. Some laptops with Modern Standby can't wake for apps."/>
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionLabel}" Text="NEW ALARMS START WITH"/>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20,16" Margin="0,0,0,22">
        <StackPanel>
          <TextBlock Text="Sound" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <DockPanel Margin="0,0,0,16">
            <Button x:Name="PlayButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Play" Margin="8,0,0,0" Click="Play_Click"/>
            <ComboBox x:Name="SoundBox" SelectionChanged="Sound_Changed"/>
          </DockPanel>
          <TextBlock Text="Snooze length" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ComboBox x:Name="SnoozeBox" Width="160" HorizontalAlignment="Left" SelectionChanged="Snooze_Changed"/>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionLabel}" Text="ABOUT"/>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20,16">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Open data folder" Click="OpenData_Click" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/logo.png" Width="48" Height="48"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" FontSize="15" FontWeight="Bold"/>
              <TextBlock Text="Rise wise." FontSize="13" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
