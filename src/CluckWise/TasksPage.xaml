<UserControl x:Class="CluckWise.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Tasks" FontSize="28" FontWeight="ExtraBold"/>
      <TextBlock x:Name="SubtitleText" FontSize="14" Foreground="{DynamicResource Muted}"/>
    </StackPanel>

    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="16,14" Margin="0,0,0,16">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Add task" Margin="10,0,0,0" Click="Add_Click"/>
          <ComboBox x:Name="PriorityBox" DockPanel.Dock="Right" Width="130" Margin="10,0,0,0" ToolTip="Priority">
            <ComboBoxItem Content="Normal"/>
            <ComboBoxItem Content="High"/>
            <ComboBoxItem Content="Low"/>
          </ComboBox>
          <Grid>
            <TextBox x:Name="QuickBox" Style="{StaticResource Field}" KeyDown="QuickBox_KeyDown" TextChanged="QuickBox_TextChanged"/>
            <TextBlock x:Name="QuickHint" Text="Try “Call Mum at 3pm”, “Pay rent tomorrow 9am !high” or “Stretch in 20 min”"
                       Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </DockPanel>
        <TextBlock x:Name="PreviewText" FontSize="13" Foreground="{DynamicResource Muted}" Margin="4,8,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="Nothing to do. Add a task above, with a time if you'd like a reminder." Foreground="{DynamicResource Muted}"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
      <ItemsControl x:Name="TaskList">
        <ItemsControl.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="2,12,0,8">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                  <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" FontSize="13" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,8">
              <StackPanel>
                <DockPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Card_Click" ToolTip="Click to edit">
                  <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="30" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource Muted}" Cursor="Hand" ToolTip="Delete" Tag="{Binding}" Click="Delete_Click"/>
                  <Border x:Name="prio" DockPanel.Dock="Right" CornerRadius="8" Padding="8,2" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource Chip}">
                    <TextBlock x:Name="prioText" Text="{Binding PriorityText}" FontSize="12" FontWeight="Bold"/>
                  </Border>
                  <TextBlock x:Name="due" DockPanel.Dock="Right" Text="{Binding DueText}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0"/>
                  <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Center" Click="Done_Click" ToolTip="Mark done"/>
                  <TextBlock x:Name="title" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ContentControl x:Name="editor" Content="{Binding}"/>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding PriorityText}" Value="">
                <Setter TargetName="prio" Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Priority}" Value="High">
                <Setter TargetName="prio" Property="Background" Value="#E5484D"/>
                <Setter TargetName="prioText" Property="Foreground" Value="White"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                <Setter TargetName="due" Property="Foreground" Value="#E5484D"/>
                <Setter TargetName="card" Property="BorderBrush" Value="#E5484D"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Done}" Value="True">
                <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                <Setter TargetName="title" Property="Opacity" Value="0.55"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Yolk}"/>
                <Setter TargetName="editor" Property="ContentTemplate">
                  <Setter.Value>
                    <DataTemplate>
                      <StackPanel Margin="0,12,0,2">
                        <TextBox x:Name="EditTitle" Style="{StaticResource Field}" Text="{Binding Title, Mode=OneTime}" Margin="0,0,0,8" Loaded="EditTitle_Loaded"/>
                        <WrapPanel>
                          <DatePicker x:Name="EditDate" Width="170" Margin="0,0,8,8" SelectedDate="{Binding Due, Mode=OneTime}"/>
                          <TextBox x:Name="EditTime" Style="{StaticResource Field}" Width="110" Margin="0,0,8,8" ToolTip="Time, e.g. 3pm or 15:30 (leave empty for no time)" Loaded="EditTime_Loaded"/>
                          <ComboBox x:Name="EditPriority" Width="130" Margin="0,0,8,8" Loaded="EditPriority_Loaded">
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="High"/>
                          </ComboBox>
                          <Button Style="{StaticResource SecondaryButton}" Content="No date" Margin="0,0,8,8" Click="ClearDate_Click"/>
                        </WrapPanel>
                        <TextBox x:Name="EditNotes" Style="{StaticResource Field}" Text="{Binding Notes, Mode=OneTime}" Margin="0,0,0,10" ToolTip="Notes (optional)"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,8,0" Click="EditCancel_Click"/>
                          <Button Style="{StaticResource PrimaryButton}" Content="Save" Click="EditSave_Click"/>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </Setter.Value>
                </Setter>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsEditing}" Value="False">
                <Setter TargetName="editor" Property="ContentTemplate">
                  <Setter.Value><DataTemplate/></Setter.Value>
                </Setter>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
