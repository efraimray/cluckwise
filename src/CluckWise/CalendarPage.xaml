<UserControl x:Class="CluckWise.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SecondaryButton}" Content="‹" Width="44" FontSize="18" Click="Prev_Click" ToolTip="Previous month"/>
        <Button Style="{StaticResource SecondaryButton}" Content="Today" Margin="8,0" Click="Today_Click"/>
        <Button Style="{StaticResource SecondaryButton}" Content="›" Width="44" FontSize="18" Click="Next_Click" ToolTip="Next month"/>
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="MonthText" FontSize="28" FontWeight="ExtraBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Ellipse Width="9" Height="9" Fill="{DynamicResource Yolk}" VerticalAlignment="Center"/>
          <TextBlock Text=" Alarms    " FontSize="13" Foreground="{DynamicResource Muted}"/>
          <Ellipse Width="9" Height="9" Fill="#E5484D" VerticalAlignment="Center"/>
          <TextBlock Text=" Birthdays    " FontSize="13" Foreground="{DynamicResource Muted}"/>
          <Ellipse Width="9" Height="9" Fill="#3B82F6" VerticalAlignment="Center"/>
          <TextBlock Text=" Tasks" FontSize="13" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <Border x:Name="DayPanel" DockPanel.Dock="Right" Width="300" Margin="16,0,0,0" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="18,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <TextBlock x:Name="DayTitle" FontSize="18" FontWeight="ExtraBold"/>
          <TextBlock x:Name="DaySubtitle" FontSize="13" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="DayItems"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <UniformGrid x:Name="WeekdayRow" Columns="7" Margin="0,0,0,6"/>
      <UniformGrid x:Name="DayGrid" Grid.Row="1" Columns="7" Rows="6"/>
    </Grid>
  </DockPanel>
</UserControl>
